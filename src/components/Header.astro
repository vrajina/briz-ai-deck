---
export interface Props {
  totalSlides?: number;
}

const { totalSlides = 8 } = Astro.props;
---

<header class="header-briz">
  <div class="brand-group">
    <a href="/" title="Презентация базы отдыха Бриз" class="brand-link">
      <!-- High contrast badge with larger white logo -->
      <div class="logo-badge">
        <img src="/logo-white.svg" alt="Бриз логотип" class="briz-logo-img" />
      </div>
      <div class="brand-text">
        <span class="brand-name nobr">БРИЗ</span>
        <span class="brand-x">×</span>
        <span class="brand-sub nobr">AI-ТРАНСФОРМАЦИЯ</span>
      </div>
    </a>
  </div>

  <div class="header-controls">
    <div class="slide-indicator">
      <span class="current" id="currentSlideNum">01</span>
      <span class="sep">/</span>
      <span class="total">{String(totalSlides).padStart(2, '0')}</span>
    </div>

    <div class="nav-buttons">
      <button id="btnPrev" class="icon-btn" title="Предыдущий слайд (←)" aria-label="Предыдущий слайд">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button id="btnNext" class="icon-btn" title="Следующий слайд (→)" aria-label="Следующий слайд">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
      </button>
      <button id="btnFullscreen" class="icon-btn" title="На весь экран" aria-label="На весь экран">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
      </button>
    </div>
  </div>
</header>

<div class="progress-bar-briz">
  <div class="progress-fill-briz" id="progressFill"></div>
</div>

<style>
  .header-briz {
    position: relative;
    z-index: 10;
    height: 64px;
    padding: 0 3.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
    border-bottom: 1px solid var(--border-color, #d6d0c4);
    box-shadow: 0 1px 0 rgba(18, 24, 23, 0.03);
  }

  .brand-group {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .brand-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .logo-badge {
    width: 44px;
    height: 44px;
    background: #111a19;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    border: 1px solid rgba(0, 0, 0, 0.1);
  }

  .briz-logo-img {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }

  .brand-text {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .brand-name {
    font-family: var(--font-title);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: 0.16em;
    color: var(--text-main, #121817);
  }

  .brand-x {
    color: var(--accent-terracotta, #c85a38);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .brand-sub {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--text-muted, #54605e);
  }

  .header-controls {
    display: flex;
    align-items: center;
    gap: 1.35rem;
  }

  .slide-indicator {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-main, #121817);
    display: flex;
    align-items: center;
    gap: 4px;
    font-variant-numeric: tabular-nums;
  }

  .slide-indicator .current {
    font-weight: 700;
    color: var(--accent-terracotta);
  }

  .slide-indicator .sep {
    color: var(--text-light, #7e8c89);
  }

  .slide-indicator .total {
    color: var(--text-muted, #54605e);
  }

  .nav-buttons {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .icon-btn {
    background: #ffffff;
    border: 1px solid var(--border-color, #d6d0c4);
    color: var(--text-main, #121817);
    width: 38px;
    height: 38px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.18s ease;
  }

  .icon-btn:hover {
    background: #121817;
    color: #ffffff;
    border-color: #121817;
  }

  .progress-bar-briz {
    position: relative;
    z-index: 10;
    width: 100%;
    height: 3px;
    background: #e5e0d5;
  }

  .progress-fill-briz {
    height: 100%;
    width: 12.5%;
    background: linear-gradient(90deg, #121817 0%, #c85a38 100%);
    transition: width 0.3s ease-out;
  }

  @media (max-width: 768px) {
    .header-briz {
      padding: 0 1.25rem;
      height: 58px;
    }
    .brand-sub {
      display: none;
    }
  }
</style>
