---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'ИИ-трансформация базы отдыха Бриз: автоматизация продаж, загрузка в несезон и консьерж-сервис 24/7' } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="https://static.tildacdn.com/tild3234-3963-4666-b936-346439633534/svg_logo_.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-brand-dark text-gray-100 min-h-screen selection:bg-brand-orange selection:text-white">
    <!-- Background glowing ambient spots -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden -z-10">
      <div class="absolute -top-40 -left-40 w-96 h-96 bg-brand-orange/10 rounded-full blur-[120px]"></div>
      <div class="absolute top-1/3 -right-40 w-[30rem] h-[30rem] bg-amber-600/10 rounded-full blur-[140px]"></div>
      <div class="absolute -bottom-40 left-1/4 w-[32rem] h-[32rem] bg-brand-orange/5 rounded-full blur-[150px]"></div>
    </div>

    <!-- Header / Navigation -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-brand-dark/80 backdrop-blur-md border-b border-white/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="#hero" class="flex items-center gap-3 group">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-brand-orange to-brand-amber flex items-center justify-center font-bold text-black text-sm tracking-tighter">
            Б
          </div>
          <div class="flex flex-col">
            <span class="font-extrabold tracking-wider text-sm text-white group-hover:text-brand-orange transition-colors">БРИЗ</span>
            <span class="text-[10px] text-gray-400 font-mono tracking-widest uppercase">AI Transformation</span>
          </div>
        </a>

        <nav class="hidden md:flex items-center gap-6 text-xs uppercase tracking-wider font-medium text-gray-300">
          <a href="#audit" class="hover:text-brand-orange transition-colors">Аудит и боли</a>
          <a href="#architecture" class="hover:text-brand-orange transition-colors">Архитектура</a>
          <a href="#deepseek" class="hover:text-brand-orange transition-colors">Почему китайские LLM</a>
          <a href="#offseason" class="hover:text-brand-orange transition-colors">Несезон</a>
          <a href="#pricing" class="hover:text-brand-orange transition-colors">Тарифы</a>
          <a href="#roi" class="hover:text-brand-orange transition-colors">Окупаемость</a>
          <a href="#roadmap" class="hover:text-brand-orange transition-colors">Сроки</a>
        </nav>

        <div class="flex items-center gap-3">
          <a href="#pricing" class="px-4 py-2 rounded-full text-xs font-semibold bg-brand-orange text-white hover:bg-brand-darkOrange transition-all shadow-lg shadow-brand-orange/20">
            Выбрать тариф
          </a>
        </div>
      </div>
    </header>

    <main class="pt-16">
      <slot />
    </main>

    <footer class="border-t border-white/10 bg-brand-surface py-12 mt-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6 text-sm text-gray-400">
        <div class="flex items-center gap-3">
          <span class="font-bold text-white tracking-wider">БРИЗ • Самара, Волга</span>
          <span class="text-xs text-gray-500">|</span>
          <span class="text-xs text-gray-400">Концепция внедрения искусственного интеллекта</span>
        </div>
        <div class="text-xs text-gray-500">
          Разработано для собственников и руководства briz.club • 2026
        </div>
      </div>
    </footer>
  </body>
</html>
