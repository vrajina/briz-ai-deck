---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ru" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="h-full bg-nature-bg text-nature-text overflow-hidden select-none river-bg flex flex-col justify-between">
    <!-- Header with Briz Logo & Topic -->
    <header class="h-16 px-6 sm:px-10 flex items-center justify-between border-b border-white/5 bg-nature-bg/90 backdrop-blur z-20 shrink-0">
      <div class="flex items-center gap-4">
        <!-- Official Briz SVG Logo -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-9 h-9 p-1 rounded-lg bg-nature-sand/10 border border-nature-sand/20 flex items-center justify-center text-nature-sand group-hover:text-nature-terracotta transition-colors">
            <img src="/logo-current.svg" alt="Бриз логотип" class="w-7 h-7 object-contain brightness-200" />
          </div>
          <div class="flex flex-col">
            <span class="font-extrabold tracking-widest text-sm text-white uppercase group-hover:text-nature-sand transition-colors">БРИЗ</span>
            <span class="text-[10px] text-nature-muted tracking-wider uppercase">База отдыха на Волге • briz.club</span>
          </div>
        </a>
      </div>

      <!-- Slide Counter and Progress Pills -->
      <div class="flex items-center gap-3">
        <div id="slide-progress" class="hidden sm:flex items-center gap-1.5">
          <!-- Dynamically populated progress dots/pills -->
        </div>
        <div class="px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-mono text-nature-sand">
          <span id="current-slide-num" class="font-bold text-white">01</span> / <span id="total-slides-num">08</span>
        </div>
      </div>
    </header>

    <!-- Main Slide Workspace -->
    <main class="flex-1 relative overflow-hidden flex items-center justify-center p-4 sm:p-8">
      <slot />
    </main>

    <!-- Slide Deck Navigation Footer -->
    <footer class="h-16 px-6 sm:px-10 flex items-center justify-between border-t border-white/5 bg-nature-bg/90 backdrop-blur z-20 shrink-0">
      <div class="text-xs text-nature-muted hidden md:flex items-center gap-2">
        <span>Управление:</span>
        <kbd class="px-2 py-0.5 rounded bg-white/10 text-white font-mono text-[10px]">←</kbd>
        <kbd class="px-2 py-0.5 rounded bg-white/10 text-white font-mono text-[10px]">→</kbd>
        <span>или</span>
        <kbd class="px-2.5 py-0.5 rounded bg-white/10 text-white font-mono text-[10px]">Пробел</kbd>
      </div>

      <div class="flex items-center gap-3 w-full md:w-auto justify-between md:justify-end">
        <button id="prev-btn" class="px-5 py-2 rounded-xl text-xs font-semibold bg-white/5 hover:bg-white/10 text-nature-sand border border-white/10 transition-all flex items-center gap-2 disabled:opacity-30 disabled:cursor-not-allowed">
          <span>←</span> Назад
        </button>

        <button id="next-btn" class="px-6 py-2 rounded-xl text-xs font-bold bg-nature-terracotta hover:bg-nature-terracottaDark text-white transition-all shadow-md flex items-center gap-2 disabled:opacity-30 disabled:cursor-not-allowed">
          Далее <span>→</span>
        </button>
      </div>
    </footer>

    <!-- Slide Deck Controller Script -->
    <script>
      let currentSlide = 0;
      const slides = document.querySelectorAll('.slide-item');
      const totalSlides = slides.length;
      const prevBtn = document.getElementById('prev-btn') as HTMLButtonElement;
      const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;
      const currentNumEl = document.getElementById('current-slide-num');
      const totalNumEl = document.getElementById('total-slides-num');
      const progressContainer = document.getElementById('slide-progress');

      if (totalNumEl) {
        totalNumEl.textContent = totalSlides.toString().padStart(2, '0');
      }

      // Build progress dots
      if (progressContainer) {
        progressContainer.innerHTML = '';
        for (let i = 0; i < totalSlides; i++) {
          const dot = document.createElement('button');
          dot.className = `w-7 h-1.5 rounded-full transition-all ${i === 0 ? 'bg-nature-terracotta' : 'bg-white/15 hover:bg-white/30'}`;
          dot.title = `Слайд ${i + 1}`;
          dot.addEventListener('click', () => goToSlide(i));
          progressContainer.appendChild(dot);
        }
      }

      function updateSlide(index: number) {
        if (index < 0) index = 0;
        if (index >= totalSlides) index = totalSlides - 1;
        currentSlide = index;

        slides.forEach((slide, idx) => {
          if (idx === currentSlide) {
            slide.classList.add('active');
          } else {
            slide.classList.remove('active');
          }
        });

        if (currentNumEl) {
          currentNumEl.textContent = (currentSlide + 1).toString().padStart(2, '0');
        }

        if (prevBtn) prevBtn.disabled = currentSlide === 0;
        if (nextBtn) {
          if (currentSlide === totalSlides - 1) {
            nextBtn.innerHTML = 'В начало <span>↺</span>';
          } else {
            nextBtn.innerHTML = 'Далее <span>→</span>';
          }
        }

        // Update progress dots
        if (progressContainer) {
          const dots = progressContainer.children;
          for (let i = 0; i < dots.length; i++) {
            dots[i].className = `w-7 h-1.5 rounded-full transition-all ${i === currentSlide ? 'bg-nature-terracotta' : 'bg-white/15 hover:bg-white/30'}`;
          }
        }

        // Update hash
        window.location.hash = `slide-${currentSlide + 1}`;
      }

      function goToSlide(index: number) {
        updateSlide(index);
      }

      function nextSlide() {
        if (currentSlide === totalSlides - 1) {
          updateSlide(0);
        } else {
          updateSlide(currentSlide + 1);
        }
      }

      function prevSlide() {
        if (currentSlide > 0) {
          updateSlide(currentSlide - 1);
        }
      }

      if (prevBtn) prevBtn.addEventListener('click', prevSlide);
      if (nextBtn) nextBtn.addEventListener('click', nextSlide);

      // Keyboard navigation
      window.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'Space' || e.key === 'PageDown') {
          e.preventDefault();
          nextSlide();
        } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
          e.preventDefault();
          prevSlide();
        }
      });

      // Touch / Swipe support
      let touchStartX = 0;
      let touchEndX = 0;
      window.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      window.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].screenX;
        if (touchEndX < touchStartX - 50) {
          nextSlide();
        }
        if (touchEndX > touchStartX + 50) {
          prevSlide();
        }
      }, { passive: true });

      // Init on load by hash
      const hash = window.location.hash;
      if (hash && hash.startsWith('#slide-')) {
        const slideIdx = parseInt(hash.replace('#slide-', '')) - 1;
        if (!isNaN(slideIdx) && slideIdx >= 0 && slideIdx < totalSlides) {
          updateSlide(slideIdx);
        } else {
          updateSlide(0);
        }
      } else {
        updateSlide(0);
      }
    </script>
  </body>
</html>
